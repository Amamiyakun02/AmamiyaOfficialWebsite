# Contoh environment variable — salin ke .env.local untuk lokal,
# atau isi di dashboard Vercel (Settings > Environment Variables) untuk deploy.
# JANGAN isi nilai rahasia di file ini.

# URL publik backend Vienna Agent. Bila diisi, browser memanggil backend
# langsung ke alamat ini (wajib HTTPS + CORS backend mengizinkan domain
# situs ini). Inilah mode untuk deploy di Vercel.
# Bila kosong, panggilan memakai alamat relatif /v1/* yang diteruskan
# next.config.ts ke BACKEND_ORIGIN (mode lokal / satu mesin).
NEXT_PUBLIC_API_URL=https://api.amamiya.web.id

# Backend tujuan rewrites /v1/* saat NEXT_PUBLIC_API_URL kosong.
# Hanya dibaca server Next saat start — tidak berpengaruh di Vercel
# bila NEXT_PUBLIC_API_URL sudah diisi.
BACKEND_ORIGIN=http://127.0.0.1:8000

# Endpoint layanan Remove Background (opsional; ada nilai bawaan di kode).
# NEXT_PUBLIC_REMOVE_BG_URL=
